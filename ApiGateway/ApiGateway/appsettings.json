{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "http://localhost:8081",
    "Issuer": "peaker-auth",
    "Audience": "peaker-api",
    "RequireHttpsMetadata": false
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/login" }
      },
      "auth-register": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/register" }
      },
      "auth-swagger": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/auth/swagger/{**remainder}" },
        "Transforms": [ { "PathPattern": "/swagger/{**remainder}" } ]
      },
      "auth": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/auth/{**remainder}" }
      },
      "jwks": {
        "ClusterId": "auth",
        "Match": { "Path": "/.well-known/{**remainder}" }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "auth-service": { "Address": "http://localhost:8081/" }
        }
      }
    }
  }
}
