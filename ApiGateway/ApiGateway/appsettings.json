{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "http://localhost:8081",
    "Issuer": "peaker-auth",
    "Audience": "peaker-api",
    "RequireHttpsMetadata": false
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/login" }
      },
      "auth-register": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/register" }
      },
      "auth-email-resend": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/email/resend" }
      },
      "auth-swagger": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/auth/swagger/{**remainder}" },
        "Transforms": [ { "PathPattern": "/swagger/{**remainder}" } ]
      },
      "auth": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/auth/{**remainder}" }
      },
      "jwks": {
        "ClusterId": "auth",
        "Match": { "Path": "/.well-known/{**remainder}" }
      },
      "account-swagger": {
        "ClusterId": "account",
        "Match": { "Path": "/api/account/swagger/{**remainder}" },
        "Transforms": [ { "PathPattern": "/swagger/{**remainder}" } ]
      },
      "account": {
        "ClusterId": "account",
        "Match": { "Path": "/api/profiles/{**remainder}" }
      },
      "collections": {
        "ClusterId": "account",
        "Match": { "Path": "/api/collections/{**remainder}" }
      },
      "peak-swagger": {
        "ClusterId": "peak",
        "Match": { "Path": "/api/peak/swagger/{**remainder}" },
        "Transforms": [ { "PathPattern": "/swagger/{**remainder}" } ]
      },
      "peak": {
        "ClusterId": "peak",
        "Match": { "Path": "/api/peaks/{**remainder}" }
      },
      "ascent-swagger": {
        "ClusterId": "ascent",
        "Match": { "Path": "/api/ascent/swagger/{**remainder}" },
        "Transforms": [ { "PathPattern": "/swagger/{**remainder}" } ]
      },
      "ascent": {
        "ClusterId": "ascent",
        "Match": { "Path": "/api/ascents/{**remainder}" }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "auth-service": { "Address": "http://localhost:8081/" }
        }
      },
      "account": {
        "Destinations": {
          "account-service": { "Address": "http://localhost:8082/" }
        }
      },
      "peak": {
        "Destinations": {
          "peak-service": { "Address": "http://localhost:8083/" }
        }
      },
      "ascent": {
        "Destinations": {
          "ascent-service": { "Address": "http://localhost:8084/" }
        }
      }
    }
  }
}
