{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "http://localhost:8081",
    "Issuer": "peaker-auth",
    "Audience": "peaker-api",
    "RequireHttpsMetadata": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/login" }
      },
      "auth-register": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/register" }
      },
      "auth-email-resend": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/email/resend" }
      },
      "auth-password-forgot": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/password/forgot" }
      },
      "auth-password-reset": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/password/reset" }
      },
      "auth-logout": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/auth/logout", "Methods": [ "POST" ] }
      },
      "auth-export-me": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/auth/me/export", "Methods": [ "GET" ] }
      },
      "auth-delete-me": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/auth/me", "Methods": [ "DELETE" ] }
      },
      "auth-swagger": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/auth/swagger/v1/swagger.json" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "admin-profiles": {
        "ClusterId": "account",
        "AuthorizationPolicy": "admin",
        "Order": 0,
        "Match": { "Path": "/api/admin/profiles/{**remainder}" }
      },
      "admin-ascents": {
        "ClusterId": "ascent",
        "AuthorizationPolicy": "admin",
        "Order": 0,
        "Match": { "Path": "/api/admin/ascents/{**remainder}" }
      },
      "admin": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "admin",
        "Order": 5,
        "Match": { "Path": "/api/admin/{**remainder}" }
      },
      "auth": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/auth/{**remainder}" }
      },
      "jwks": {
        "ClusterId": "auth",
        "Match": { "Path": "/.well-known/{**remainder}" }
      },
      "account-swagger": {
        "ClusterId": "account",
        "Match": { "Path": "/api/account/swagger/v1/swagger.json" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "profiles-me": {
        "ClusterId": "account",
        "AuthorizationPolicy": "authenticated",
        "Order": 1,
        "Match": { "Path": "/api/profiles/me/{**remainder}" }
      },
      "account": {
        "ClusterId": "account",
        "Order": 2,
        "Match": { "Path": "/api/profiles/{**remainder}" }
      },
      "collections": {
        "ClusterId": "account",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/collections/{**remainder}" }
      },
      "peak-swagger": {
        "ClusterId": "peak",
        "Match": { "Path": "/api/peak/swagger/v1/swagger.json" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "peak-search": {
        "ClusterId": "peak",
        "RateLimiterPolicy": "catalog",
        "Order": 1,
        "Match": { "Path": "/api/peaks/search" }
      },
      "peak-nearby": {
        "ClusterId": "peak",
        "RateLimiterPolicy": "catalog",
        "Order": 1,
        "Match": { "Path": "/api/peaks/nearby" }
      },
      "peak": {
        "ClusterId": "peak",
        "Order": 2,
        "Match": { "Path": "/api/peaks/{**remainder}" }
      },
      "ascent-swagger": {
        "ClusterId": "ascent",
        "Match": { "Path": "/api/ascent/swagger/v1/swagger.json" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "ascents-export": {
        "ClusterId": "ascent",
        "AuthorizationPolicy": "authenticated",
        "Order": 0,
        "Match": { "Path": "/api/ascents/me/export", "Methods": [ "GET" ] }
      },
      "ascents-mine": {
        "ClusterId": "ascent",
        "AuthorizationPolicy": "authenticated",
        "Order": 1,
        "Match": { "Path": "/api/ascents", "Methods": [ "GET" ] }
      },
      "ascents-write": {
        "ClusterId": "ascent",
        "AuthorizationPolicy": "authenticated",
        "Order": 1,
        "Match": { "Path": "/api/ascents/{**remainder}", "Methods": [ "POST", "PUT", "DELETE" ] }
      },
      "ascent": {
        "ClusterId": "ascent",
        "Order": 2,
        "Match": { "Path": "/api/ascents/{**remainder}" }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "auth-service": { "Address": "http://localhost:8081/" }
        }
      },
      "account": {
        "Destinations": {
          "account-service": { "Address": "http://localhost:8082/" }
        }
      },
      "peak": {
        "Destinations": {
          "peak-service": { "Address": "http://localhost:8083/" }
        }
      },
      "ascent": {
        "Destinations": {
          "ascent-service": { "Address": "http://localhost:8084/" }
        }
      }
    }
  }
}
